# Local development only. Copy to .env, which git ignores, and pick your own values.
# AWS never reads this file: it uses SSM Parameter Store.
POSTGRES_PASSWORD=change-me-local-superuser
ROOMLY_OWNER_PASSWORD=change-me-local-owner
ROOMLY_APP_PASSWORD=change-me-local-app
SESSION_SECRET=change-me-long-random-string
DEMO_PASSWORD=change-me-demo
DEMO_MODE=true
